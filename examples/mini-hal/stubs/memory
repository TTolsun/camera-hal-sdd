#pragma once
#include <utility>
namespace std {
template <class T> class unique_ptr {
public:
    unique_ptr() {}
    unique_ptr(T* p) : p_(p) {}
    unique_ptr(unique_ptr&& o) : p_(o.p_) { o.p_ = nullptr; }
    template <class U> unique_ptr(unique_ptr<U>&& o) : p_(o.release()) {}
    ~unique_ptr() { delete p_; }
    unique_ptr& operator=(unique_ptr&& o) { p_ = o.p_; o.p_ = nullptr; return *this; }
    T* operator->() const { return p_; }
    T& operator*() const { return *p_; }
    T* get() const { return p_; }
    T* release() { T* p = p_; p_ = nullptr; return p; }
    void reset(T* p = nullptr) { delete p_; p_ = p; }
    explicit operator bool() const { return p_ != nullptr; }
private:
    T* p_ = nullptr;
};
template <class T, class... Args> unique_ptr<T> make_unique(Args&&... args) { return unique_ptr<T>(new T(forward<Args>(args)...)); }
}
